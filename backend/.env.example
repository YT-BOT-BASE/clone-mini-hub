# CLONE MINI HUB - Environment Variables
# Copy this file to .env and fill your real values. NEVER commit .env to GitHub!

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas - https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/clone-mini-hub?retryWrites=true&w=majority

# JWT Secrets - generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email (Gmail App Password or any SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CLONE MINI HUB <noreply@cloneminHub.lk>

# Redis (Optional - leave empty to disable)
REDIS_URL=

# TMDB - https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# AI Providers (Optional - leave empty = AI API returns clear Unavailable error, never fake data)
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini

# Weather - https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Cobalt API for downloads (Optional) - https://cobalt.tools
COBALT_API_URL=https://api.cobalt.tools

# Admin seed
ADMIN_EMAIL=admin@cloneminHub.lk
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=CLONE SHANUWA

# Security
API_KEY_PEPPER=change_this_pepper_for_api_key_hashing_at_least_32_chars
