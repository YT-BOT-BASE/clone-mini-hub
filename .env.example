# Root-level env example (same variables as backend/.env.example)
# Copy to backend/.env on VPS, or set these in Heroku Config Vars.

PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app.herokuapp.com

MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/clone-mini-hub?retryWrites=true&w=majority

JWT_ACCESS_SECRET=generate_with_crypto_randomBytes_64_hex
JWT_REFRESH_SECRET=generate_another_different_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-app.herokuapp.com/api/auth/google/callback

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CLONE MINI HUB <noreply@cloneminHub.lk>

REDIS_URL=
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=gemini
OPENWEATHER_API_KEY=
COBALT_API_URL=https://api.cobalt.tools

ADMIN_EMAIL=admin@cloneminHub.lk
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=CLONE SHANUWA

API_KEY_PEPPER=generate_another_random_string_min_32_chars
